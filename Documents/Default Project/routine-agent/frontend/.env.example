# Google Calendar integration (frontend-safe values only)
# Create these at https://console.cloud.google.com
#
# 1. Create a Google Cloud project
# 2. Enable "Google Calendar API"
# 3. Configure OAuth consent screen (External) and add yourself as a test user
# 4. Create credentials -> OAuth client ID -> Web application
# 5. Add authorized JavaScript origins:
#      http://localhost:5173
#      <your deployed Netlify origin>
# 6. Copy the values below
#
# NOTE: Never commit a real .env file. This file is a template only.

VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-api-key
